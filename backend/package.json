{
  "name": "ai-detector-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"node scripts/start_ml_server.js\" \"nodemon --watch src/server.js --watch ../frontend/js/ --watch ../frontend/css/ --watch ../frontend/ src/server.js\"",
    "tw:build": "npx tailwindcss -c ../frontend/tailwind.config.js -i ../frontend/css/tailwind-input.css -o ../frontend/css/tailwind.css --minify",
    "test:integration": "node --test ../tests/gateway.integration.test.mjs",
    "benchmark": "node ../tools/benchmark_gateway.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.12.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  }
}
